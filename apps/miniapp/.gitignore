# Local runtime override generated by scripts/prepare-env.mjs. Never commit it; it is bundled
# into preview and upload packages on purpose, so uploads must pass check:upload.
config.local.js

# Local WeChat DevTools override, optionally written by scripts/prepare-appid.mjs.
# Use it to test with a different AppID without editing the tracked config.
project.private.config.json

# miniprogram-ci upload private key, downloaded from the WeChat MP console.
private.*.key
