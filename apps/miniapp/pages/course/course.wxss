.banner {
  width: 100%;
  height: 320rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background: #eef0f2;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.price {
  margin: 16rpx 0;
}

.hint {
  margin-top: 16rpx;
  color: #646a73;
  font-size: 26rpx;
}

.cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #3370ff;
  color: #ffffff;
  font-size: 30rpx;
}

.section-title {
  margin: 24rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.chapter-name {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.lesson {
  padding: 18rpx 0;
  border-top: 1rpx solid #dee0e3;
}

.lesson-title {
  font-size: 28rpx;
}

.retry {
  margin-top: 24rpx;
}
