.name {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: #eef0f2;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #3370ff;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.small-btn {
  height: 60rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.retry {
  margin-top: 24rpx;
}
