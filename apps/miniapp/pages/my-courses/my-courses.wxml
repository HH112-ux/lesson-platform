<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <view wx:elif="{{errorText}}" class="card empty">
    <text>{{errorText}}</text>
    <view class="btn btn--ghost retry" bindtap="load">重新加载</view>
  </view>

  <view wx:elif="{{records.length === 0}}" class="card empty">
    还没有已购课程，去首页挑选一门吧
  </view>

  <view wx:for="{{records}}" wx:key="courseId" class="card">
    <view class="title-row">
      <text class="name" data-id="{{item.courseId}}" bindtap="openCourse">{{item.title}}</text>
      <text wx:if="{{item.refunded}}" class="badge">已退款</text>
    </view>
    <view class="bar">
      <view class="bar-fill" style="width: {{item.progressWidth}}"></view>
    </view>
    <view class="row">
      <text class="muted small">{{item.hintText}}</text>
      <view
        class="btn small-btn {{item.refunded ? 'btn--ghost' : ''}}"
        data-id="{{item.courseId}}"
        data-lesson="{{item.lastLessonId}}"
        data-refunded="{{item.refunded}}"
        bindtap="continueLearning"
      >{{item.actionText}}</view>
    </view>
  </view>
</view>
