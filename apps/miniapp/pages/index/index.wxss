.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.entry {
  color: #3370ff;
  font-size: 26rpx;
}

.chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.chips .chip {
  display: inline-block;
  margin-right: 16rpx;
}

.course {
  display: flex;
  gap: 20rpx;
}

.cover {
  width: 220rpx;
  height: 132rpx;
  border-radius: 12rpx;
  background: #eef0f2;
  flex-shrink: 0;
}

.body {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
}

.retry {
  margin-top: 24rpx;
}
