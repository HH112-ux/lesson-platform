/**
 * Shared styles of the mini program pages.
 */
page {
  background: #f5f6f7;
  color: #1f2329;
  font-size: 28rpx;
}

.page {
  padding: 24rpx;
}

.muted {
  color: #646a73;
}

.small {
  font-size: 24rpx;
}

.card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  border-radius: 6rpx;
  background: #eef3ff;
  color: #3370ff;
  font-size: 22rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 12rpx;
  background: #3370ff;
  color: #ffffff;
  font-size: 30rpx;
}

.btn--ghost {
  background: #ffffff;
  border: 1rpx solid #3370ff;
  color: #3370ff;
}

.btn--disabled {
  background: #c9cdd4;
  color: #ffffff;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #646a73;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #646a73;
  font-size: 26rpx;
}

.chip--active {
  background: #3370ff;
  color: #ffffff;
}

.price {
  color: #d83931;
  font-size: 32rpx;
  font-weight: 600;
}
