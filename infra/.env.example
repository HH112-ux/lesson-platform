# 本地开发环境变量模板（复制为 infra/.env 后按需修改）
# 约束：所有变量 LP_ 前缀（AGENTS.md 11.5）；此处均为本地开发占位值，禁止填入真实密钥。
LP_TIMEZONE=Asia/Shanghai

# MySQL（root 口令与业务账号见 infra/mysql/init/00-create-databases.sql）
LP_MYSQL_PORT=3306
LP_MYSQL_ROOT_PASSWORD=lp_root_dev

# Redis
LP_REDIS_PORT=6379

# Nacos（standalone；控制台 http://localhost:8848/nacos）
LP_NACOS_PORT=8848

# RocketMQ NameServer
LP_ROCKETMQ_NAMESRV_PORT=9876

# MinIO（API 9000 / 控制台 9001）
LP_MINIO_API_PORT=9000
LP_MINIO_CONSOLE_PORT=9001
LP_MINIO_ROOT_USER=lpminio
LP_MINIO_ROOT_PASSWORD=lp_minio_dev
